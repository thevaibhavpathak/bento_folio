---
import Card from "./Card/index.astro";
import Pulse from "./Pulse.astro";
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-2">
  <div class="flex justify-between w-full items-start mb-2">
    <div class="flex flex-col">
      <h1>Now</h2>
      <a href="https://sive.rs/nowff" target="_blank">
        <span class="text-s text-gray-500 cursor-pointer">what's that ?</span>
      </a>
    </div>
    <Pulse />
  </div>
  <p class="text-base">
  Creating Player Interfaces at&nbsp;
  <a
    href="https://play.google.com/store/apps/details?id=cricketgames.hitwicket.strategy&hl=en_IN"
    target="_blank"
    class="font-medium transition-colors hover:text-[#8AD216] inline underline"
  >
    Hitwicket
  </a>
</p>
</Card>
